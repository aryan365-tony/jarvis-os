# Needed once jarvis-shell.service + llama-server.service exist as cgroup-scoped units
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y

# Needed for cage/wayland kiosk to get GPU access without a DE
CONFIG_DRM_KMS_FB_HELPER=y

# Needed so systemd-journald captures early boot + jarvis-shell logs for the audit trail
CONFIG_PRINTK=y
CONFIG_PROC_FS=y
