[Unit]
Description=Download optional Jarvis GGUF model
Wants=network-online.target
After=network-online.target
ConditionPathExistsGlob=!/home/jarvisuser/dev/jarvis-os/llama/models/*.gguf

[Service]
Type=oneshot
ExecStart=/bin/bash /home/jarvisuser/dev/jarvis-os/llama/download-model.sh --start-llama

[Install]
WantedBy=multi-user.target
