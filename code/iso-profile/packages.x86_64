# --- Installer + btrfs/snapper snapshot foundation (Phase 0) ---
# btrfs-progs: subvolume/snapshot primitives for @/@home/@snapshots/@var_log.
# snapper:     pre-action snapshots + rollback (Phase 3 safety net).
# gptfdisk (sgdisk), dosfstools (mkfs.fat), arch-install-scripts (genfstab,
# arch-chroot): required by /usr/local/bin/jarvis-install to lay down the
# installed btrfs system from the live medium.
btrfs-progs
snapper
gptfdisk
dosfstools
arch-install-scripts

# --- Jarvis shell runtime ---
python
python-pip
python-pyqt6
python-qasync
python-httpx
python-psutil
qt6-declarative
qt6-wayland
sqlite

# --- Phase 5 voice pipeline (optional accelerators) ---
# Audio stack + native libs the Python voice engines bind to. The Python
# packages themselves (openwakeword/faster-whisper/piper-tts/sounddevice) are
# installed via pip during customize_airootfs; these provide the system audio
# server and the PortAudio/ONNX runtime they depend on. python-sounddevice is
# AUR-only, so it is NOT listed here (pip installs it against libportaudio).
pipewire
pipewire-pulse
wireplumber
portaudio
python-numpy
brightnessctl
dialog
playerctl
upower
libnotify
