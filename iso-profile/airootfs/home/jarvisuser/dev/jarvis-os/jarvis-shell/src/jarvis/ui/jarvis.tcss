/* Jarvis workspace theme.
 *
 * Design goals: clear visual hierarchy, calm dark surface with a cyan accent,
 * generous spacing, and *purposeful* motion. Every transition communicates
 * state (arrival of a message, a panel sliding in) rather than decoration.
 * Accessibility variants (.reduced-motion, .high-contrast) are first-class.
 */

Screen {
    layout: vertical;
    background: #0b0f14;
    color: #d7e2ee;
}

/* --- top HUD ------------------------------------------------------------ */
#statusbar {
    dock: top;
    height: 1;
    padding: 0 2;
    background: #0f1620;
    color: #9fb3c8;
}

#hintbar {
    dock: bottom;
    height: 1;
    padding: 0 2;
    background: #0f1620;
    color: #5b6b7d;
}

/* --- main body ---------------------------------------------------------- */
#body {
    height: 1fr;
}

#main {
    width: 1fr;
    height: 1fr;
}

#conversation {
    height: 1fr;
    padding: 1 2;
    background: #0b0f14;
    scrollbar-size-vertical: 1;
}

/* --- message bubbles ---------------------------------------------------- */
Message {
    layout: vertical;
    height: auto;
    margin: 1 0;
    padding: 1 2;
    border: round #1c2733;
}

Message.user {
    border: round #14324a;
    background: #0e1a24;
}

Message.assistant {
    border: round #123a34;
    background: #0c1713;
}

Message.system {
    border: round #23202e;
    color: #9a8fb0;
}

Message .who {
    color: #4fd6c9;
    text-style: bold;
}

Message.user .who {
    color: #4fa3ff;
}

.body {
    height: auto;
}

.streaming {
    color: #eaf2fb;
}

/* Subtle entrance for arriving messages. Base opacity stays fully visible;
 * the fade-in is applied imperatively on mount so text is never hidden if the
 * animation is skipped (e.g. reduced motion). */
StreamingMessage {
    height: auto;
}

/* --- composer ----------------------------------------------------------- */
#composer {
    dock: bottom;
    height: 3;
    padding: 0 2;
    background: #0f1620;
}

#composer .voice-hint {
    width: 14;
    content-align: left middle;
    color: #7f93a8;
}

#composer Input {
    border: tall #1c2733;
    background: #0b131c;
}

#composer Input:focus {
    border: tall #4fd6c9;
}

/* --- backend activity panel -------------------------------------------- */
#status-panel {
    width: 42;
    height: 1fr;
    padding: 1 2;
    background: #0d141d;
    border-left: vkey #1c2733;
}

.panel-title {
    text-style: bold;
    color: #4fd6c9;
    margin-bottom: 1;
}

.svc-list {
    height: auto;
    margin-bottom: 1;
}

.svc-log {
    height: 1fr;
    background: #0a1017;
    border: round #16202b;
}

/* --- dialogs / onboarding ---------------------------------------------- */
.dialog {
    width: 64;
    height: auto;
    padding: 2 3;
    background: #10171f;
    border: round #4fd6c9;
}

.dialog-title {
    text-style: bold;
    color: #4fd6c9;
    margin-bottom: 1;
}

.dialog-body {
    height: auto;
    margin-bottom: 1;
}

.dialog-code {
    height: auto;
    color: #9fb3c8;
    background: #0a1017;
    padding: 1 2;
    margin-bottom: 1;
}

.dialog Button {
    margin: 1 1 0 1;
}

/* --- accessibility variants -------------------------------------------- */
.reduced-motion StreamingMessage {
    opacity: 100%;
}

.high-contrast Screen,
.high-contrast #conversation {
    background: #000000;
    color: #ffffff;
}

.high-contrast Message {
    border: round #ffffff;
}

.high-contrast #composer Input:focus {
    border: tall #ffffff;
}

