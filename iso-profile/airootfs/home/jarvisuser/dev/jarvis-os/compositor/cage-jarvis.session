#!/usr/bin/env bash
set -uo pipefail
LOG="/home/jarvisuser/.local/share/jarvis/cage.log"
mkdir -p "$(dirname "$LOG")"

# Resolve the shell source dir relative to this script so `python -m jarvis.main`
# always finds the package, regardless of how the session is launched.
SELF="$(cd "$(dirname "$0")" && pwd)"
SRC="$SELF/../jarvis-shell/src"
export PYTHONPATH="$SRC${PYTHONPATH:+:$PYTHONPATH}"
cd "$SRC" 2>/dev/null || cd "$SELF"

while true; do
  if command -v foot >/dev/null 2>&1; then
    # Textual is a terminal UI, so run it inside a terminal emulator under cage.
    cage -- foot --fullscreen python -m jarvis.main >>"$LOG" 2>&1
  else
    # Fallback for environments without foot: run directly on tty.
    python -m jarvis.main >>"$LOG" 2>&1
  fi
  code=$?
  echo "$(date -Is) jarvis.main exited code=$code" >> "$LOG"
  if [ "$code" -eq 0 ]; then break; fi
  sleep 2   # backoff before restart, avoid a tight crash loop pegging CPU
done
