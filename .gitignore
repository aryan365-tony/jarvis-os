# Regenerated ISO staging artifacts
# setup.sh rsyncs the whole repo into the live airootfs and stages the compiled
# llama backend under /usr/local/lib. These are fully regenerated at build time
# and must never be committed.
iso-profile/airootfs/home/jarvisuser/dev/jarvis-os/
iso-profile/airootfs/usr/local/lib/

